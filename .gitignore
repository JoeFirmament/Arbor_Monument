# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.pyc
*.tsbuildinfo
/scripts/__pycache__/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/output/
/work/

# Local research caches and review artifacts
/data/source-cache/
/data/source-images/
/data/rejected/

# Research-only images that are not licensed for public redistribution
/public/images/species/lineart/
/public/images/wenmiao/fan-zhongyan.png
